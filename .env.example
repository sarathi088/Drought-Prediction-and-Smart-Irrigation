# Server Port (used for local Node.js backend)
PORT=5005

# Frontend API URL:
# - For Vercel Production Deployment: Leave empty (defaults to '/api' same-origin serverless function)
# - For Dedicated External Backend: https://your-agridrought-project.vercel.app
# - For Local Development with Vite: Defaults to http://localhost:5005 via proxy
VITE_API_URL=

# Database Credentials (PostgreSQL / Supabase - Optional)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

NODE_ENV=development
